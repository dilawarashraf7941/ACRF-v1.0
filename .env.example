# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM providers (consumed via LiteLLM) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- ChromaDB ---
CHROMA_PERSIST_DIRECTORY=.chroma

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
